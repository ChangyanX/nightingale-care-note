# Browser-safe Supabase configuration.
# Copy these two values to apps/web/.env.local for Next.js local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Supabase configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Reserved for the internal worker and one-off administrative setup only.
# Never expose this value to browser code or use it for normal user requests.
SUPABASE_SERVICE_ROLE_KEY=

# Direct connection is reserved for migrations, tests, and controlled worker jobs.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase CLI project linking uses a personal access token managed by the CLI,
# not an application environment variable. Never add that token here.

# Phase 4 genuine AI-scribe integration
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
# Fully local alternative: LLM_PROVIDER=ollama, LLM_MODEL=qwen3:4b,
# LLM_BASE_URL=http://127.0.0.1:11434/v1. LLM_API_KEY is unused for Ollama.

# API settings
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Optional live RLS integration tests. Obtain short-lived access tokens by signing
# in as the local synthetic users; never commit populated values.
NIGHTINGALE_RUN_RLS_INTEGRATION=0
NIGHTINGALE_TEST_STAFF_A_TOKEN=
NIGHTINGALE_TEST_CLINICIAN_A_TOKEN=
NIGHTINGALE_TEST_PATIENT_A_TOKEN=
NIGHTINGALE_TEST_ADMIN_A_TOKEN=
